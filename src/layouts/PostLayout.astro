---
import '@/styles/global.css'
import type { PostLayoutProps } from '@/types'
import FormattedDate from '@/components/widgets/FormattedDate.astro'
import FootnoteScroll from '@/components/widgets/FootnoteScroll.astro'
import BaseHead from '@/components/layout/BaseHead.astro'
import Header from '@/components/layout/Header.astro'
import Footer from '@/components/layout/Footer.astro'
import BackButton from '@/components/ui/BackButton.astro'
import TableOfContents from '@/components/ui/TableOfContents.astro'
import GradientMask from '@/components/ui/GradientMask.astro'
import ImageOptimizer from '@/components/ui/ImageOptimizer.astro'
import ImageViewer from '@/components/ui/ImageViewer.astro'
import GitHubCard from '@/components/ui/GitHubCard.astro'
import LinkCard from '@/components/ui/LinkCard.astro'
import NeoDBCard from '@/components/ui/NeoDBCard.astro'
import XPOST from '@/components/ui/XPOST.astro'
import CopyCode from '@/components/ui/CopyCode.astro'
import PostTaxonomy from '@/components/widgets/PostTaxonomy.astro'
import PostThumbnail from '@/components/ui/PostThumbnail.astro'
import BaseLayout from '@/layouts/BaseLayout.astro'

import { themeConfig } from '@/config'

const { title, pubDate, description, readingTime, toc, category, topics, author } =
  Astro.props as PostLayoutProps & {
    category?: string
    topics?: string[]
    author?: string
  }

const postSlug = Astro.url.pathname.split('/').filter(Boolean).pop() || ''
// Pre-rendered by `scripts/generate-og-images.ts` during `prebuild`.
const ogImage = `/open-graph/${postSlug}.png`
---

<BaseLayout title={title} description={description} type="post">
  <BaseHead
    title={title}
    description={description}
    ogImage={ogImage}
    ogImageAlt={`${title} — ${category ?? themeConfig.site.title}`}
    type="article"
    pubDate={pubDate}
    author={author}
    category={category}
    topics={topics}
    slot="head"
  />
  <div class="post-container">
    <main>
      <div class="prose">
        <GradientMask />
        <BackButton />
        <Header />
        {themeConfig.post.toc && <TableOfContents toc={toc} />}
        {
          category && (
            <div class="post-banner">
              <PostThumbnail slug={postSlug} category={category} variant="banner" />
            </div>
          )
        }
        <div class="title">
          <h1>{title}</h1>
          <div class="date">
            <FormattedDate date={pubDate} context="post" />
            {
              author && (
                <span class="byline">
                  <span class="separator">·</span>
                  {author}
                </span>
              )
            }
            {
              themeConfig.post.readingTime && readingTime && (
                <span class="reading-time">
                  <span class="separator">·</span>
                  {readingTime.text}
                </span>
              )
            }
          </div>
          {category && <PostTaxonomy category={category} topics={topics} />}
        </div>
        <slot />
      </div>
    </main>
    <ImageOptimizer />
    <FootnoteScroll />
    <CopyCode />
    <GitHubCard />
    <XPOST />
    <NeoDBCard />
    {themeConfig.post.imageViewer && <ImageViewer />}
    {themeConfig.post.linkCard && <LinkCard />}
    {themeConfig.general.footer && <Footer />}
  </div>
</BaseLayout>

<style>
  .post-container {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .post-container main {
    flex: 1;
  }

  .post-banner {
    display: block;
    overflow: hidden;
    aspect-ratio: 4 / 1;
    margin: 1.5rem 0 2rem;
    border-radius: 0.375rem;
    background-color: var(--surface-strong);
    color: var(--text-secondary);
  }
</style>
