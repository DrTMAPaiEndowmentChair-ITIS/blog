---
// Vocabulary size trades embedding memory against sequence length
---

<figure class="viz" aria-labelledby="vcc-title" data-vcc-motion>
  <div class="viz-header">
    <figcaption id="vcc-title">
      Vocabulary size trades embedding memory against sequence length
    </figcaption>
    <button
      type="button"
      data-replay
      aria-label="Replay vocabulary size trades embedding memory against sequence length"
      >Replay</button
    >
  </div>
  <div class="unit">
    Relative cost for a fixed corpus. Larger vocabularies shorten sequences but enlarge the
    embedding and output layers.
  </div>
  <div class="rows">
    <div class="row" style={`--delay:${160}ms; --width:100%`}>
      <>
        <span class="name">32k vocab</span>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="value">longest seqs</span>
        <span class="note"
          >Small embedding matrix, more tokens per document, worse fertility on non-English text.</span
        >
      </>
    </div>
    <div class="row" style={`--delay:${240}ms; --width:72%`}>
      <>
        <span class="name">128k vocab</span>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="value">~15% fewer tokens</span>
        <span class="note"
          >Common frontier choice; multilingual fertility improves markedly over 32k.</span
        >
      </>
    </div>
    <div class="row" style={`--delay:${320}ms; --width:66%`}>
      <>
        <span class="name">256k vocab</span>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="value">diminishing</span>
        <span class="note"
          >Sequence savings flatten while the untied output projection keeps growing.</span
        >
      </>
    </div>
    <div class="row" style={`--delay:${400}ms; --width:90%`}>
      <>
        <span class="name">Byte-level fallback</span>
        <span class="bar" aria-hidden="true"><i></i></span>
        <span class="value">no OOV</span>
        <span class="note"
          >Never fails on unseen input, but rare scripts inflate token counts severely.</span
        >
      </>
    </div>
  </div>
  <div class="legend">
    <i></i> Every token saved is saved at every layer; every vocabulary entry is paid for once in memory
    and once per softmax
  </div>
</figure>

<style>
  .viz {
    margin: 2em 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--astro-code-background);
    color: var(--text-primary);
  }
  figcaption {
    font: 600 var(--font-size-s) var(--mono);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .viz-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }
  button {
    min-width: 4.5rem;
    min-height: 2.75rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--border);
    background: var(--bg);
    color: var(--text-secondary);
    font: 0.72rem var(--mono);
    cursor: pointer;
    transition:
      transform 140ms cubic-bezier(0.23, 1, 0.32, 1),
      opacity 140ms cubic-bezier(0.23, 1, 0.32, 1);
  }
  button:active {
    transform: scale(0.97);
  }
  button:focus-visible {
    outline: 2px solid var(--text-primary);
    outline-offset: 2px;
  }
  .unit {
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg);
    font: 0.74rem var(--mono);
    color: var(--text-tertiary);
  }
  .rows {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.8rem;
  }
  .row {
    display: grid;
    grid-template-columns: 9rem 1fr 6.5rem;
    grid-template-areas: 'name bar value' 'note note note';
    align-items: center;
    gap: 0.5rem 0.8rem;
    padding: 0.7rem 0.75rem;
    border-left: 3px solid var(--text-secondary);
    background: var(--bg);
  }
  .name {
    grid-area: name;
    font: 0.8rem var(--mono);
  }
  .bar {
    grid-area: bar;
    display: block;
    height: 10px;
    border: 1px solid var(--border);
  }
  .bar i {
    display: block;
    height: 100%;
    width: var(--width);
    background: var(--text-secondary);
  }
  .value {
    grid-area: value;
    text-align: right;
    font: 0.76rem var(--mono);
    color: var(--text-secondary);
  }
  .note {
    grid-area: note;
    font: 0.72rem var(--mono);
    color: var(--text-tertiary);
    line-height: 1.5;
  }
  .legend {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font: 0.78rem var(--mono);
    color: var(--text-secondary);
  }
  .legend i {
    display: inline-block;
    width: 18px;
    border-top: 3px solid var(--text-secondary);
    margin-right: 0.5rem;
  }
  .motion-ready:not(.is-running) .row,
  .motion-ready:not(.is-running) .legend {
    opacity: 0;
    transform: translateY(7px);
  }
  .motion-ready:not(.is-running) .bar i {
    width: 0;
  }
  .motion-ready.is-running .row {
    animation: vcc-enter 320ms var(--delay) cubic-bezier(0.23, 1, 0.32, 1) both;
  }
  .motion-ready.is-running .bar i {
    animation: vcc-grow 520ms var(--delay) cubic-bezier(0.23, 1, 0.32, 1) both;
  }
  .motion-ready.is-running .legend {
    animation: vcc-enter 300ms 900ms cubic-bezier(0.23, 1, 0.32, 1) both;
  }
  @keyframes vcc-enter {
    from {
      opacity: 0;
      transform: translateY(7px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  @keyframes vcc-grow {
    from {
      width: 0;
    }
    to {
      width: var(--width);
    }
  }
  @media (hover: hover) and (pointer: fine) {
    button:hover {
      opacity: 0.72;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    button {
      display: none;
    }
    .motion-ready * {
      animation: none !important;
      opacity: 1 !important;
    }
    .motion-ready .bar i {
      width: var(--width);
    }
  }
  @media (max-width: 620px) {
    .viz-header {
      align-items: flex-start;
    }
    .row {
      grid-template-columns: 1fr auto;
      grid-template-areas: 'name value' 'bar bar' 'note note';
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-vcc-motion]').forEach((figure) => {
    if (figure.dataset.motionBound || matchMedia('(prefers-reduced-motion: reduce)').matches) return

    figure.dataset.motionBound = 'true'
    figure.classList.add('motion-ready')

    const play = () => {
      figure.classList.remove('is-running')
      void figure.offsetWidth
      figure.classList.add('is-running')
    }

    figure.querySelector('[data-replay]')?.addEventListener('click', play)
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return
        play()
        observer.disconnect()
      },
      { threshold: 0.35 }
    )
    observer.observe(figure)
  })
</script>
