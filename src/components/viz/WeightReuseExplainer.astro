<section class="weight-reuse-explainer" aria-labelledby="weight-reuse-title">
  <p id="weight-reuse-title" class="figure-title">One weight bank, several token rows</p>
  <iframe
    data-weight-reuse
    src="/explainers/hairline-weight-reuse-engine.html"
    title="Interactive isometric weight-reuse engine"
    loading="lazy"></iframe>
  <p class="figure-caption">
    Move across the token rails or press play. Batching lets several token rows reuse the same
    weights. This schematic shows the reuse mechanism; latency and KV traffic still depend on the
    workload.{' '}
    <a href="/explainers/hairline-weight-reuse-engine.html?play=1">Open the figure</a>.
  </p>
</section>

<script>
  let dispose = () => {}

  function bindFigure() {
    dispose()
    const frame = document.querySelector<HTMLIFrameElement>('[data-weight-reuse]')
    if (!frame) return
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)')
    const sync = () => {
      const params = new URLSearchParams({
        theme: document.documentElement.classList.contains('dark') ? 'dark' : 'light'
      })
      if (!motion.matches) params.set('play', '1')
      const src = `/explainers/hairline-weight-reuse-engine.html?${params}`
      if (frame.getAttribute('src') !== src) frame.src = src
    }
    const observer = new MutationObserver(sync)
    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] })
    motion.addEventListener('change', sync)
    dispose = () => {
      observer.disconnect()
      motion.removeEventListener('change', sync)
      dispose = () => {}
    }
    sync()
  }

  document.addEventListener('astro:page-load', bindFigure)
  document.addEventListener('astro:before-swap', () => dispose())
  bindFigure()
</script>

<style>
  .weight-reuse-explainer {
    margin: 2.5rem 0;
  }
  :global(.prose) .weight-reuse-explainer .figure-title {
    margin: 0 0 0.75rem;
    font: 500 1rem/1.5 var(--display);
  }
  :global(.prose) .weight-reuse-explainer iframe {
    display: block;
    width: 100%;
    height: 40rem;
    margin: 0;
    aspect-ratio: auto;
    border: 1px solid var(--border);
    border-radius: 0.375rem;
  }
  :global(.prose) .weight-reuse-explainer .figure-caption {
    margin: 0.75rem 0 0;
    font-size: var(--font-size-s);
    line-height: 1.7;
  }
  @media (max-width: 560px) {
    :global(.prose) .weight-reuse-explainer iframe {
      height: 36rem;
    }
  }
</style>
