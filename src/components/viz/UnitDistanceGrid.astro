---
const side = 5
const step = 46
const pad = 34
const points = Array.from({ length: side * side }, (_, i) => ({
  col: i % side,
  row: Math.floor(i / side),
  x: pad + (i % side) * step,
  y: pad + Math.floor(i / side) * step
}))
const edges = points.flatMap((p) => {
  const right = points.find((q) => q.row === p.row && q.col === p.col + 1)
  const down = points.find((q) => q.col === p.col && q.row === p.row + 1)
  return [right, down].filter(Boolean).map((q) => ({ p, q: q! }))
})
const size = pad * 2 + (side - 1) * step
---

<figure class="viz grid-viz" aria-labelledby="unit-distance-grid-title">
  <figcaption id="unit-distance-grid-title">
    <strong>The square grid, the configuration everyone assumed was optimal</strong>
    <span>
      Each segment joins a pair of points at distance exactly 1. Diagonals are longer, so they do
      not count.
    </span>
  </figcaption>

  <div class="panel">
    <div class="plot">
      <svg viewBox={`0 0 ${size} ${size}`} role="img" aria-labelledby="unit-distance-grid-alt">
        <title id="unit-distance-grid-alt">
          A five by five square lattice of 25 points with 40 unit-length segments drawn between
          horizontally and vertically adjacent points.
        </title>
        {
          edges.map((e) => (
            <line class="edge" x1={e.p.x} y1={e.p.y} x2={e.q.x} y2={e.q.y} />
          ))
        }
        {points.map((p) => <circle class="node" cx={p.x} cy={p.y} r="4" />)}
      </svg>
    </div>

    <dl class="counts">
      <div>
        <dt>Points</dt>
        <dd>n = 25</dd>
      </div>
      <div>
        <dt>Unit-distance pairs</dt>
        <dd>40</dd>
      </div>
      <div>
        <dt>Total pairs</dt>
        <dd>300</dd>
      </div>
      <div>
        <dt>Grid growth rate</dt>
        <dd>n<sup>1+c/log log n</sup></dd>
      </div>
      <div>
        <dt>Beaten in 2026 by</dt>
        <dd>n<sup>1+&delta;</sup>, &delta; &gt; 0 fixed</dd>
      </div>
    </dl>
  </div>

  <p class="note">
    A plain <span>k &times; k</span> lattice gives only about <span>2n</span> unit distances.
    Erd&#337;s improved this by rescaling the lattice so that many integer pairs share a common
    sum of squares; that trick is what produces the slowly growing
    <span>c / log log n</span> exponent, and it was the record for eighty years.
  </p>
</figure>

<style>
  .viz {
    container-type: inline-size;
    margin: 2em 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--astro-code-background);
    color: var(--text-primary);
  }
  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.15rem;
  }
  figcaption strong {
    font: 600 var(--font-size-s) var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  figcaption span {
    color: var(--text-secondary);
    font: 0.7rem/1.5 var(--mono);
  }
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(11rem, 0.8fr);
    gap: 1rem;
    align-items: start;
  }
  .plot {
    padding: 0.9rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  svg {
    display: block;
    width: 100%;
  }
  .edge {
    stroke: var(--text-secondary);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }
  .node {
    fill: var(--text-primary);
  }
  .counts {
    display: grid;
    gap: 0;
    margin: 0;
    border-top: 2px solid var(--text-secondary);
  }
  .counts div {
    display: grid;
    gap: 0.2rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }
  dt,
  dd {
    margin: 0;
    font: 0.68rem/1.45 var(--mono);
  }
  dt {
    color: var(--text-tertiary);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  dd {
    color: var(--text-primary);
    font-weight: 600;
  }
  .note {
    margin: 1rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font: 0.68rem/1.6 var(--mono);
  }
  .note span {
    color: var(--text-primary);
  }
  @container (max-width: 520px) {
    .panel {
      grid-template-columns: 1fr;
    }
  }
</style>
