---
const W = 420
const H = 250
const L = 46
const R = 12
const T = 18
const B = 34

const x = (year: number) => L + ((year - 1946) / (2026 - 1946)) * (W - L - R)
const y = (exp: number) => T + ((1.36 - exp) / (1.36 - 0.98)) * (H - T - B)

const upper = [
  { year: 1946, exp: 1.5, label: null },
  { year: 1984, exp: 1.3333, label: null },
  { year: 2026, exp: 1.3333, label: null }
]
const lower = [
  { year: 1946, exp: 1.005 },
  { year: 2026, exp: 1.005 },
  { year: 2026, exp: 1.014 }
]

const upperPath = `M${x(1946)} ${y(1.36)}L${x(1984)} ${y(1.3333)}L${x(2026)} ${y(1.3333)}`
const lowerPath = `M${x(1946)} ${y(1.005)}L${x(2026)} ${y(1.005)}`
const gapPath = `M${x(1946)} ${y(1.36)}L${x(1984)} ${y(1.3333)}L${x(2026)} ${y(1.3333)}L${x(2026)} ${y(1.005)}L${x(1946)} ${y(1.005)}Z`

const ticks = [1946, 1966, 1986, 2006, 2026]
const gridLines = [1.0, 1.1, 1.2, 1.3]
---

<figure class="viz bounds-viz" aria-labelledby="unit-distance-bounds-title">
  <figcaption id="unit-distance-bounds-title">
    <strong>Eighty years of exponents, and which side finally moved</strong>
    <span>
      Exponent &beta; in u(n) &asymp; n<sup>&beta;</sup>. Upper bounds come down from proofs; lower
      bounds come up from constructions. The shaded band is the region nobody could eliminate.
    </span>
  </figcaption>

  <div class="plot">
    <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="unit-distance-bounds-alt">
      <title id="unit-distance-bounds-alt">
        A chart of the unit-distance exponent from 1946 to 2026. The upper bound falls from 1.5 to
        1.333 in 1984 and stays there. The lower bound sits just above 1 until 2026, when it jumps
        to 1.014.
      </title>

      <path class="gap" d={gapPath}></path>

      {
        gridLines.map((g) => (
          <g>
            <line class="grid" x1={L} y1={y(g)} x2={W - R} y2={y(g)} />
            <text class="tick" x={L - 8} y={y(g) + 3} text-anchor="end">
              {g.toFixed(1)}
            </text>
          </g>
        ))
      }

      <line class="axis" x1={L} y1={T} x2={L} y2={H - B}></line>
      <line class="axis" x1={L} y1={H - B} x2={W - R} y2={H - B}></line>

      {
        ticks.map((t) => (
          <text class="tick" x={x(t)} y={H - B + 15} text-anchor="middle">
            {t}
          </text>
        ))
      }

      <path class="upper" d={upperPath}></path>
      <path class="lower" d={lowerPath}></path>
      <path class="jump" d={`M${x(2026)} ${y(1.005)}L${x(2026)} ${y(1.014)}`}></path>

      {
        upper.map((p) => (
          <circle class="dot" cx={x(p.year)} cy={y(p.exp > 1.4 ? 1.36 : p.exp)} r="3.2" />
        ))
      }
      {lower.map((p) => <circle class="dot" cx={x(p.year)} cy={y(p.exp)} r="3.2" />)}

      <text class="note upper-note" x={x(1947)} y={y(1.36) - 6}> 1946: O(n^3/2), clipped </text>
      <text class="note upper-note" x={x(1988)} y={y(1.3333) - 9}>
        upper bound O(n^4/3), unchanged since 1984
      </text>
      <text class="note lower-note" x={x(1950)} y={y(1.005) + 16}>
        lower bound n^(1+c/log log n), the grid
      </text>
      <text class="note gap-note" x={x(1988)} y={y(1.16)}> the gap </text>
      <text class="note move-note" x={x(2024)} y={y(1.055)} text-anchor="end">
        2026: &delta; &gt; 0
      </text>
    </svg>
  </div>

  <ul class="legend">
    <li><i class="k-upper" aria-hidden="true"></i> Upper bound &mdash; what a proof forbids</li>
    <li>
      <i class="k-lower" aria-hidden="true"></i> Lower bound &mdash; what a construction achieves
    </li>
    <li><i class="k-gap" aria-hidden="true"></i> Undetermined region</li>
  </ul>

  <p class="note-text">
    Erd&#337;s conjectured the truth sat at the bottom of the band, at n<sup>1+o(1)</sup>. The 2026
    result moved the lower edge up by a fixed polynomial amount, so the bottom of the band is now
    provably wrong. The top edge, O(n<sup>4/3</sup>), was not touched.
  </p>
</figure>

<style>
  .viz {
    container-type: inline-size;
    margin: 2em 0;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: var(--astro-code-background);
    color: var(--text-primary);
  }
  figcaption {
    display: grid;
    gap: 0.35rem;
    margin-bottom: 1.15rem;
  }
  figcaption strong {
    font: 600 var(--font-size-s) var(--mono);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  figcaption span {
    color: var(--text-secondary);
    font: 0.7rem/1.5 var(--mono);
  }
  .plot {
    padding: 0.75rem;
    border: 1px solid var(--border);
    background: var(--bg);
  }
  svg {
    display: block;
    width: 100%;
  }
  path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }
  .gap {
    fill: var(--text-primary);
    opacity: 0.07;
  }
  .grid {
    stroke: var(--border);
    stroke-dasharray: 2 4;
  }
  .axis {
    stroke: var(--border);
  }
  .upper {
    stroke: var(--text-primary);
    stroke-width: 2;
  }
  .lower {
    stroke: var(--text-secondary);
    stroke-width: 2;
    stroke-dasharray: 5 4;
  }
  .jump {
    stroke: var(--text-primary);
    stroke-width: 3;
  }
  .dot {
    fill: var(--text-primary);
  }
  text {
    fill: var(--text-secondary);
    font: 0.62rem var(--mono);
  }
  .tick {
    fill: var(--text-tertiary);
    font-size: 0.58rem;
  }
  .gap-note {
    fill: var(--text-tertiary);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.1rem;
    margin: 0.9rem 0 0;
    padding: 0;
    list-style: none;
    color: var(--text-secondary);
    font: 0.66rem/1.5 var(--mono);
  }
  .legend li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .legend i {
    width: 1.1rem;
    height: 0;
    border-top: 2px solid var(--text-primary);
  }
  .k-lower {
    border-top-style: dashed;
    border-top-color: var(--text-secondary);
  }
  .k-gap {
    height: 0.6rem;
    border: 1px solid var(--border);
    background: var(--text-tertiary);
    opacity: 0.35;
  }
  .note-text {
    margin: 0.9rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    color: var(--text-secondary);
    font: 0.68rem/1.6 var(--mono);
  }
  @container (max-width: 460px) {
    .upper-note,
    .lower-note,
    .move-note {
      display: none;
    }
  }
</style>
