---
import { themeConfig } from '@/config'
const today = new Date()
---

<footer>
  <div class="footer-content">
    <div class="copyright">
      <span class="date">
        &copy;
        {today.getFullYear()}
      </span>
      {' '}
      {themeConfig.site.author}
    </div>
    <div class="powered-by">
      <a href="/feeds" title="Subscribe with RSS">RSS</a>
      <span class="separator">·</span>
      Powered by{' '}
      <a href="https://astro.build">Astro</a>
    </div>
  </div>
</footer>
<style>
  footer {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-light);
    line-height: 1.75;
    color: var(--text-secondary);
    opacity: 0.75;
    margin-top: 4rem;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-direction: row;
    /*
      Both halves refuse to break mid-phrase, so a row that cannot wrap has a
      minimum width of the two of them side by side — which the author name
      pushes past the viewport on a phone, scrolling the whole page sideways.
      Wrapping lets the second half drop to its own line at exactly the width
      it stops fitting, with no breakpoint to keep in sync with the content.
    */
    flex-wrap: wrap;
    gap: 0.15rem 1.5rem;
    width: 100%;
  }

  .copyright,
  .powered-by {
    white-space: nowrap;
  }

  .copyright .date {
    opacity: 1;
  }

  .powered-by .separator {
    margin: 0 0.35rem;
    opacity: 0.5;
  }

  footer a {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s ease-out;
  }

  footer a:hover {
    color: var(--text-primary);
  }
</style>
