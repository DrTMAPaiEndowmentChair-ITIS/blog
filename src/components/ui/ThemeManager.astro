<!--
  This is a critical style block to prevent flashing on page load in dark mode.
  It is injected into the <head> of the document before the main stylesheets are loaded.
-->
<style is:inline>
  :root {
    --bg: #ffffff;
  }

  html.dark {
    --bg: #1c1c1c;
  }

  html {
    background-color: var(--bg);
    color-scheme: light;
  }

  html.dark {
    color-scheme: dark;
  }

  /*
    Theme switch reveal. The incoming theme is painted on top of the outgoing one
    and uncovered by a circle growing out of the toggle button, so the change
    reads as a single wipe instead of every element cross-fading on its own.
    Scoped to .theme-wipe so page-navigation transitions keep their own fade.

    First, fold the page-content group back into the root snapshot for the
    duration of the switch — otherwise its navigation cross-fade runs on top of
    the wipe and the content changes theme ahead of the circle.
  */
  html.theme-wipe #transition-wrapper {
    view-transition-name: none !important;
  }

  /*
    Element-level colour transitions would smear the leading edge of the wipe,
    so hold them still while the circle travels. The toggle icons are exempt —
    they sit at the origin and their swap should still ease.
  */
  html.theme-wipe *:not(.theme-icon),
  html.theme-wipe *::before,
  html.theme-wipe *::after {
    transition-property: none !important;
  }

  html.theme-wipe::view-transition-old(root),
  html.theme-wipe::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }

  html.theme-wipe::view-transition-old(root) {
    z-index: 0;
  }

  /*
    The edge is a soft-stopped radial mask rather than a hard clip: registering
    the radius as a real length lets it animate, and the ~5rem feather keeps the
    boundary from reading as a cut-out as it crosses text and card edges.
  */
  @property --theme-wipe-p {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }

  html.theme-wipe::view-transition-new(root) {
    z-index: 1;
    mask-image: radial-gradient(
      circle at var(--theme-wipe-x, 50%) var(--theme-wipe-y, 0px),
      #000 calc(var(--theme-wipe-p, 0px) - 5rem),
      transparent var(--theme-wipe-p, 0px)
    );
    animation: theme-wipe-reveal 440ms cubic-bezier(0.3, 0.12, 0.2, 1) forwards;
  }

  @keyframes theme-wipe-reveal {
    from {
      --theme-wipe-p: 0px;
    }
    to {
      /* Overshoot by the feather width so the far corner lands fully opaque. */
      --theme-wipe-p: calc(var(--theme-wipe-r, 150vmax) + 5rem);
    }
  }

  /* Fallback for browsers without view transitions: a short colour cross-fade. */
  html.theme-fade,
  html.theme-fade *,
  html.theme-fade *::before,
  html.theme-fade *::after {
    transition:
      background-color 400ms cubic-bezier(0.32, 0.94, 0.6, 1),
      border-color 400ms cubic-bezier(0.32, 0.94, 0.6, 1),
      color 400ms cubic-bezier(0.32, 0.94, 0.6, 1),
      fill 400ms cubic-bezier(0.32, 0.94, 0.6, 1),
      stroke 400ms cubic-bezier(0.32, 0.94, 0.6, 1) !important;
    transition-delay: 0s !important;
  }

  @media (prefers-reduced-motion: reduce) {
    html.theme-wipe::view-transition-new(root) {
      animation: none;
    }
  }
</style>

<script is:inline>
  // Global Theme Manager
  ;(function () {
    // Prevent duplicate initialization
    if (window.ThemeManager && window.ThemeManager.initialized) {
      return
    }

    window.ThemeManager = {
      STORAGE_KEY: 'itis-theme',
      initialized: false,
      _fadeTimer: null,
      _transition: null,
      _wipeRun: 0,

      getSystemTheme() {
        return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
      },

      getStoredTheme() {
        try {
          return localStorage.getItem(this.STORAGE_KEY)
        } catch {
          return null
        }
      },

      setStoredTheme(theme) {
        try {
          if (theme === 'system') {
            localStorage.removeItem(this.STORAGE_KEY)
          } else {
            localStorage.setItem(this.STORAGE_KEY, theme)
          }
        } catch (e) {
          console.warn('Failed to store theme preference:', e)
        }
      },

      getEffectiveTheme() {
        const stored = this.getStoredTheme()
        return stored || 'light'
      },

      isUsingSystemTheme() {
        return this.getStoredTheme() === null
      },

      applyTheme(theme) {
        document.documentElement.classList.remove('light', 'dark')
        document.documentElement.classList.add(theme)

        // Dispatch event for other components
        document.dispatchEvent(
          new CustomEvent('themechange', {
            detail: {
              theme,
              isUserChoice: !this.isUsingSystemTheme(),
              isSystemTheme: this.isUsingSystemTheme()
            }
          })
        )
      },

      prefersReducedMotion() {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches
      },

      // Animate the swap as a circle growing from `origin` (the toggle button)
      // to the furthest corner of the viewport.
      revealFrom(origin, theme) {
        const root = document.documentElement
        const rect = origin && origin.getBoundingClientRect ? origin.getBoundingClientRect() : null
        const x = rect ? rect.left + rect.width / 2 : window.innerWidth
        const y = rect ? rect.top + rect.height / 2 : 0
        const radius = Math.hypot(
          Math.max(x, window.innerWidth - x),
          Math.max(y, window.innerHeight - y)
        )

        root.style.setProperty('--theme-wipe-x', `${x}px`)
        root.style.setProperty('--theme-wipe-y', `${y}px`)
        root.style.setProperty('--theme-wipe-r', `${radius}px`)
        root.classList.add('theme-wipe')

        // A click that lands mid-wipe restarts the reveal from the button. Drop
        // the in-flight one deterministically and tag each run, so the older
        // transition settling can't strip .theme-wipe out from under the new one.
        if (this._transition) this._transition.skipTransition()
        const run = ++this._wipeRun
        const transition = document.startViewTransition(() => this.applyTheme(theme))
        this._transition = transition

        const cleanup = () => {
          if (run !== this._wipeRun) return
          this._transition = null
          root.classList.remove('theme-wipe')
        }
        transition.finished.then(cleanup, cleanup)
      },

      setTheme(theme, origin) {
        this.setStoredTheme(theme)

        if (this.prefersReducedMotion()) {
          this.applyTheme(theme)
          return
        }

        if (typeof document.startViewTransition === 'function') {
          this.revealFrom(origin, theme)
          return
        }

        const root = document.documentElement
        root.classList.add('theme-fade')
        clearTimeout(this._fadeTimer)
        this._fadeTimer = setTimeout(() => root.classList.remove('theme-fade'), 460)
        this.applyTheme(theme)
      },

      toggle(origin) {
        const currentTheme = this.getEffectiveTheme()
        // Simply toggle between light and dark
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark'

        this.setTheme(newTheme, origin)
      },

      init() {
        if (this.initialized) return

        // If no stored preference, default to light
        if (this.getStoredTheme() === null) {
          this.setStoredTheme('light')
        }

        // Set initial theme (maintain current theme when refreshing page)
        this.applyTheme(this.getEffectiveTheme())

        // Listen for system theme changes
        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
          const newSystemTheme = e.matches ? 'dark' : 'light'

          // Only follow system theme if user has explicitly chosen system
          if (this.isUsingSystemTheme()) {
            this.applyTheme(newSystemTheme)
          }
        })

        this.initialized = true
      }
    }

    // Initialize theme manager
    window.ThemeManager.init()

    // Apply theme when needed
    const applyTheme = () => {
      if (window.ThemeManager) {
        const theme = window.ThemeManager.getEffectiveTheme()
        window.ThemeManager.applyTheme(theme)
      }
    }

    // Apply immediately on script load
    applyTheme()

    // Listen for navigation events
    document.addEventListener('astro:before-preparation', applyTheme)

    // Apply theme after DOM changes (both swap and page load)
    const applyThemeAfterNavigation = () => {
      if (window.ThemeManager) {
        const currentTheme = window.ThemeManager.getEffectiveTheme()
        const appliedTheme = document.documentElement.classList.contains('dark') ? 'dark' : 'light'

        if (currentTheme !== appliedTheme) {
          // Use requestAnimationFrame to ensure theme is applied in the next frame, avoiding conflicts with view transition
          requestAnimationFrame(() => {
            window.ThemeManager.applyTheme(currentTheme)
          })
        }
      }
    }

    document.addEventListener('astro:after-swap', applyThemeAfterNavigation)
    document.addEventListener('astro:page-load', applyThemeAfterNavigation)

    // Handle system theme changes
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (window.ThemeManager && window.ThemeManager.isUsingSystemTheme()) {
        setTimeout(applyTheme, 0)
      }
    })
  })()
</script>
