---
import { generateThumbnail, type ThumbnailVariant } from '@/utils/thumbnail'

interface Props {
  slug: string
  category: string
  variant?: ThumbnailVariant
  class?: string
}

const { slug, category, variant = 'card', class: className } = Astro.props
// The same artwork appears in the directory and the article banner. Keep its
// paths in one cached sprite rather than repeating them in every HTML response.
// Only row artwork goes in the sprite: every row is used on the index, while
// including all banner/hero variants would triple the asset's transfer size.
const art = variant === 'row' ? undefined : generateThumbnail(slug, category, variant)
const viewBox = art?.viewBox ?? '0 0 120 80'
---

<svg
  class:list={['thumb', `thumb-${variant}`, className]}
  viewBox={viewBox}
  preserveAspectRatio="xMidYMid slice"
  role="presentation"
  aria-hidden="true"
>
  {art ? <g set:html={art.markup} /> : <use href={`/thumbnails.svg#row-${slug}`} />}
</svg>

<style>
  /* Both colour and the well behind it are set by the consumer, so hover and
     focus states live with the surrounding link rather than in here. */
  .thumb {
    display: block;
    width: 100%;
    height: 100%;
    color: inherit;
  }
</style>
